  "keywords": [
    "toto",
    "microservice",
    "sdk",
    "api",
    "pubsub",
    "cloud-agnostic",
    "express",
    "typescript"
  ],
  "author": "nicolasances",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasances/toto-microservice-sdk.git",
    "directory": "node"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "body-parser": "^1.20.0",
    "connect-busboy": "^1.0.0",
    "express": "^4.18.0",
    "fs-extra": "^11.0.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.0",
    "moment-timezone": "^0.5.43",
    "mongodb": "^6.0.0",
    "request": "^2.88.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@aws-sdk/client-sns": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.958.0",
